<idea-plugin>
    <id>com.example.airefactoring</id>
    <name>IntelliJ Refactoring MCP Tools</name>
    <vendor email="dev@example.com" url="https://example.com">example</vendor>

    <description><![CDATA[
        Adds native IntelliJ refactoring operations to the built-in MCP Server.
        The validation release exposes Java Extract Method.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolset
                implementation="com.example.airefactoring.mcp.JavaRefactorToolset"/>
    </extensions>
</idea-plugin>
